# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server & Security Configuration
PORT="3000"
NODE_ENV="development"
JWT_SECRET="YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS"
DATABASE_PATH="./data/chefpulse.db"

# Live Razorpay server credentials (NEVER ship these in Android/iOS builds)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# V6 Production PostgreSQL (migration foundation; app cutover follows repository migration)
DATABASE_DRIVER="sqlite"
DATABASE_URL=""
DATABASE_SSL="true"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# PostgreSQL pool tuning (used by the V7 repository foundation)
DATABASE_POOL_MAX="10"
DATABASE_POOL_IDLE_TIMEOUT_MS="30000"
DATABASE_POOL_CONNECTION_TIMEOUT_MS="10000"

# Production must use a managed PostgreSQL database and a live payment provider.
CORS_ORIGIN="https://app.example.com"
TRUST_PROXY="true"
REQUEST_TIMEOUT_MS="30000"
SHUTDOWN_TIMEOUT_MS="10000"
PAYMENT_PROVIDER="razorpay"
ALLOW_PAYMENT_SIMULATION="false"
PAYMENT_WEBHOOK_SECRET="YOUR_LIVE_WEBHOOK_SECRET_MIN_32_CHARS"

# Public API origin used by the web app and Capacitor Android/iOS builds.
VITE_API_BASE_URL="https://api.example.com"

# Firebase Web client configuration (safe to expose in the browser; NOT service-account secrets)
# Get these from Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Web Push VAPID key is added later when push notifications are enabled.
VITE_FIREBASE_VAPID_KEY=""

# Production OTP / Exotel ExoVerify / Indian Voice + SMS
# Never commit API tokens or app secrets. Configure these only in your deployment secret store.
OTP_PROVIDER=exoverify
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_REGION="mumbai"
EXOTEL_CALLER_ID=""
EXOTEL_SMS_SENDER_ID=""
EXOTEL_DLT_ENTITY_ID=""
EXOTEL_DLT_TEMPLATE_ID=""
EXOTEL_VERIFY_APP_ID=""
EXOTEL_VERIFY_APP_SECRET=""

# V19 grocery provider webhook
GROCERY_WEBHOOK_SECRET=""
