{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowJs": false
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts"]
}
